  (text "ESP32 Wi-Fi front-end board, rev A.  Labels-only schematic: same net name = same net." (at 20 20 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "f41c3f99-0677-4779-aade-8a7e20e41895"))
  (text "Power: USB-C 5V -> D1 -> AMS1117 3.3V.  FEM supply is filtered through FB1 (+3V3_RF)." (at 20 25 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "b8929b75-9206-4a41-9f38-9a5a6356f941"))
  (text "USB-serial: CH340C with DTR/RTS auto-reset (Q1/Q2), same as ESP32-DevKitC." (at 20 30 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "7d595d05-54e1-4880-93c8-b5ae6b7c4af3"))
  (text "RF: ESP32-WROOM-32U U.FL -> short U.FL-U.FL pigtail -> J2 -> C8 -> pad R8/R9/R10 (0R / DNP)" (at 20 170 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "943582fc-8f40-4c07-ae0e-d17397559415"))
  (text "-> RFX2401C (PA 20 dBm, LNA 12 dB) -> C12 -> pi filter L1/C13/C14 -> J5 SMA edge." (at 20 175 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "c4106af3-3143-44b7-83d1-2b6d8ba6f84a"))
  (text "TX/RX switching: GPIO23 -> TXEN, GPIO18 -> RXEN via esp_wifi_set_ant_gpio() (see firmware/)." (at 20 180 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "08809074-203c-4db3-8ce6-2637f386f92c"))
  (text "Keep ESP32 TX power at ~+8 dBm max with 0R pad; RFX2401C input P1dB is about +5 dBm." (at 20 185 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "fc9fc980-f583-4797-94c4-26e279c51e1f"))
