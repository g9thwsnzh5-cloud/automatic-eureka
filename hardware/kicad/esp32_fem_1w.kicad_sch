  (text "ESP32 Wi-Fi front-end board, rev A.  Labels-only schematic: same net name = same net." (at 20 20 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "41920966-9b65-4c05-af28-433bcfe95e26"))
  (text "Power: USB-C 5V -> D1 -> AMS1117 3.3V.  FEM supply is filtered through FB1 (+3V3_RF)." (at 20 25 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "d346053b-d394-4731-8157-d9cd2c988b90"))
  (text "USB-serial: CH340C with DTR/RTS auto-reset (Q1/Q2), same as ESP32-DevKitC." (at 20 30 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "c6292e2a-e3c9-47a0-aedd-26e2ca85c6d6"))
  (text "RF: ESP32-WROOM-32U U.FL -> short U.FL-U.FL pigtail -> J2 -> C8 -> pad R8/R9/R10 (0R / DNP)" (at 20 170 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "2c5d62cc-3647-449d-b499-6cc3add2ab5e"))
  (text "-> RFX2401C (PA 20 dBm, LNA 12 dB) -> C12 -> pi filter L1/C13/C14 -> J5 SMA edge." (at 20 175 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "dfccc03e-1b4e-48fc-ae98-67f8cc9b0b81"))
  (text "TX/RX switching: GPIO23 -> TXEN, GPIO18 -> RXEN via esp_wifi_set_ant_gpio() (see firmware/)." (at 20 180 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "acb1e9cf-5dc6-4756-8e51-28b131d0d48a"))
  (text "Keep ESP32 TX power at ~+8 dBm max with 0R pad; RFX2401C input P1dB is about +5 dBm." (at 20 185 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "1eb04e68-0099-477a-9e29-a2deac83e0c9"))
