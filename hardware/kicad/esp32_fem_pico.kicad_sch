  (text "ESP32 Wi-Fi front-end board, rev A.  Labels-only schematic: same net name = same net." (at 20 20 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "7449813d-5188-42e5-be84-032cdb235681"))
  (text "Power: USB-C 5V -> D1 -> AMS1117 3.3V.  FEM supply is filtered through FB1 (+3V3_RF)." (at 20 25 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "60770717-1f42-4698-ac6b-9b65daee50f2"))
  (text "USB-serial: CH340C with DTR/RTS auto-reset (Q1/Q2), same as ESP32-DevKitC." (at 20 30 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "47b33734-7acb-40e6-a13d-710b51d7890a"))
  (text "RF: ESP32-WROOM-32U U.FL -> short U.FL-U.FL pigtail -> J2 -> C8 -> pad R8/R9/R10 (0R / DNP)" (at 20 170 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "71bcf574-bf00-4f96-b692-4086b5840de3"))
  (text "-> RFX2401C (PA 20 dBm, LNA 12 dB) -> C12 -> pi filter L1/C13/C14 -> J5 SMA edge." (at 20 175 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "cd160058-7247-40d2-b546-a3dc1338fffd"))
  (text "TX/RX switching: GPIO23 -> TXEN, GPIO18 -> RXEN via esp_wifi_set_ant_gpio() (see firmware/)." (at 20 180 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "c1048eea-86e4-41ea-89aa-66a8a91870a7"))
  (text "Keep ESP32 TX power at ~+8 dBm max with 0R pad; RFX2401C input P1dB is about +5 dBm." (at 20 185 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "d9865953-9524-4094-8c92-87fdcd68c984"))
