  (text "ESP32 Wi-Fi front-end board, rev A.  Labels-only schematic: same net name = same net." (at 20 20 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "f706c09d-f4d4-4cf9-aaaa-7d0df62c0891"))
  (text "Power: USB-C 5V -> D1 -> AMS1117 3.3V.  FEM supply is filtered through FB1 (+3V3_RF)." (at 20 25 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "0921c954-049b-4921-b2ad-a5707c8eb8f3"))
  (text "USB-serial: CH340C with DTR/RTS auto-reset (Q1/Q2), same as ESP32-DevKitC." (at 20 30 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "6f4462f1-fe31-4d76-b40a-aa786d012b4d"))
  (text "RF: ESP32-WROOM-32U U.FL -> short U.FL-U.FL pigtail -> J2 -> C8 -> pad R8/R9/R10 (0R / DNP)" (at 20 170 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "f8efc11a-9a28-4db5-ae52-3d9c072cf6d5"))
  (text "-> RFX2401C (PA 20 dBm, LNA 12 dB) -> C12 -> pi filter L1/C13/C14 -> J5 SMA edge." (at 20 175 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "a4103c5e-a9dd-4e02-9b58-01c319473135"))
  (text "TX/RX switching: GPIO23 -> TXEN, GPIO18 -> RXEN via esp_wifi_set_ant_gpio() (see firmware/)." (at 20 180 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "5ee83cb1-70ea-476e-86b6-62628b03494f"))
  (text "Keep ESP32 TX power at ~+8 dBm max with 0R pad; RFX2401C input P1dB is about +5 dBm." (at 20 185 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "4b7532f9-18f2-4328-a056-93c8be318325"))
