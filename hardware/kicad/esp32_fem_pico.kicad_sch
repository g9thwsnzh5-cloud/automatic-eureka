  (text "ESP32 Wi-Fi front-end board, rev A.  Labels-only schematic: same net name = same net." (at 20 20 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "db8ad1d5-eefd-4a09-af9a-4463a8e33c25"))
  (text "Power: USB-C 5V -> D1 -> AMS1117 3.3V.  FEM supply is filtered through FB1 (+3V3_RF)." (at 20 25 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "b595ac6f-e843-4c07-805a-ea705318f37e"))
  (text "USB-serial: CH340C with DTR/RTS auto-reset (Q1/Q2), same as ESP32-DevKitC." (at 20 30 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "860fc317-fee3-468b-b4dc-2a590f078163"))
  (text "RF: ESP32-WROOM-32U U.FL -> short U.FL-U.FL pigtail -> J2 -> C8 -> pad R8/R9/R10 (0R / DNP)" (at 20 170 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "1c454c48-e761-4db8-b098-a46f669afb21"))
  (text "-> RFX2401C (PA 20 dBm, LNA 12 dB) -> C12 -> pi filter L1/C13/C14 -> J5 SMA edge." (at 20 175 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "d3513c0f-e8d8-4272-82bb-641b4b54236a"))
  (text "TX/RX switching: GPIO23 -> TXEN, GPIO18 -> RXEN via esp_wifi_set_ant_gpio() (see firmware/)." (at 20 180 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "b487ac67-88af-4e56-914a-aa3d4189687b"))
  (text "Keep ESP32 TX power at ~+8 dBm max with 0R pad; RFX2401C input P1dB is about +5 dBm." (at 20 185 0) (effects (font (size 2 2)) (justify left bottom)) (uuid "70895efd-e199-4469-abda-5f32dab3281f"))
